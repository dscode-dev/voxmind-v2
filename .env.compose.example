# =========================================================================
# ClipFlow — Docker Compose environment template
#
# Copy to `.env` and fill in every value marked REQUIRED before starting.
# This file must never contain a real secret.
#
# Generate strong values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# =========================================================================


# =========================
# APPLICATION
# =========================
# "production" (default) or one of: development, dev, test, testing, local.
# Anything unrecognised is treated as production. A development environment is the ONLY
# way to enable FIXED_TEST_OTP below.
ENVIRONMENT=production

# Image tags. Compose builds these from the repo; override only to use a registry.
CLIPFLOW_API_IMAGE=clipflow-api:local
VOXMIND_CONTROL_PLANE_IMAGE=clipflow-control-plane:local
VOXMIND_WORKER_IMAGE=clipflow-worker:local
VOXMIND_WORKER_BASE_IMAGE=clipflow-worker-base:local

# Service ports (host side)
CLIPFLOW_API_PORT=8010
CONTROL_PLANE_PORT=8000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8010
COOKIE_SECURE=false
COOKIE_SAMESITE=lax


# =========================
# DATABASE
# =========================
POSTGRES_DB=clipflow
POSTGRES_USER=clipflow
# REQUIRED
POSTGRES_PASSWORD=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# Postgres is only used by clipflow-api, so it is bound to loopback by default.
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_EXPOSE_PORT=5432


# =========================
# REDIS
# =========================
VOXMIND_REDIS_QUEUE=voxmind_jobs
# Redis is only used inside the Compose network, so it is bound to loopback by default.
REDIS_BIND_HOST=127.0.0.1
REDIS_EXPOSE_PORT=6379


# =========================
# MINIO
# =========================
# REQUIRED
MINIO_ROOT_USER=
# REQUIRED
MINIO_ROOT_PASSWORD=

MINIO_BUCKET=voxmind
CLIPFLOW_MINIO_BUCKET=clipflow

# The API port must stay reachable from the browser: presigned asset URLs point at it.
MINIO_API_PORT=9000
# The console is admin-only, so it is bound to loopback by default.
MINIO_CONSOLE_BIND_HOST=127.0.0.1
MINIO_CONSOLE_PORT=9001

# PUBLIC endpoint — the host:port a browser can actually reach. Presigned URLs are signed
# against this value (SigV4 covers the Host header, so the host cannot be rewritten after
# signing). Set it to the address users type, e.g. `clipflow.example.com:9000`.
# The INTERNAL endpoint (minio:9000) is set by docker-compose.yml and is not configured here.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false

SIGNED_ASSET_URL_EXPIRY_SEC=3600


# =========================
# INTERNAL AUTH
# =========================
# REQUIRED. Shared secret for every /internal/* endpoint (worker and control-plane → API).
# Minimum 16 characters. The API refuses to start without it, and every internal call is
# rejected when it is missing — there is no fail-open path.
INTERNAL_API_TOKEN=


# =========================
# JWT
# =========================
# REQUIRED. Minimum 16 characters. There is no fallback secret; the API refuses to start
# without it.
JWT_SECRET=


# =========================
# AUTHENTICATION / OTP
# =========================
# LIMITATION: no SMS provider is integrated yet. In production the login code is generated
# randomly and written to the clipflow-api container log only:
#   docker compose logs clipflow-api | grep otp_issued_without_sms_provider
#
# FIXED_TEST_OTP pins the login code for local development. It is honoured ONLY when
# ENVIRONMENT is a development environment; setting it with ENVIRONMENT=production makes
# the API refuse to start. Leave it empty for production.
FIXED_TEST_OTP=

DEFAULT_ADMIN_PHONE_NUMBER=+5500000000000
DEFAULT_ADMIN_FULL_NAME=ClipFlow Admin
DEFAULT_ADMIN_CREDITS=999999
LAB_UNLIMITED_CREDIT_PHONE_NUMBERS=


# =========================
# TELEGRAM
# =========================
# REQUIRED
TELEGRAM_BOT_TOKEN=
# REQUIRED — the operational chat the bot reports into.
TELEGRAM_CHAT_ID=

# Authorization allowlists (comma-separated numeric Telegram ids).
# The bot is DENY-BY-DEFAULT: an id in neither list cannot run /new, /finalize, or send
# JSON. When both are empty, TELEGRAM_CHAT_ID is used as the single authorized chat.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=

TELEGRAM_DISABLE_NOTIFICATIONS=false
TELEGRAM_TIMEOUT_SEC=30
TELEGRAM_UPLOAD_TIMEOUT_SEC=300


# =========================
# AI
# =========================
# AI_MODE: "automatic" (worker calls the AI provider router) or "manual" (legacy Telegram
# prompt/response.json flow). A per-job `build_ia` flag overrides this.
AI_MODE=automatic

# REQUIRED when AI_MODE=automatic and no local provider is enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional local LLM node (e.g. an Ollama-compatible API). Entirely optional: with
# LOCAL_LLM_ENABLED=false nothing is contacted, and with it enabled but unreachable the
# router falls back to OpenAI. The platform never requires the local node to be online.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=qwen3:8b


# =========================
# GPU / ASR
# =========================
CUDA_VISIBLE_DEVICES=0

# Worker image build args
WORKER_POETRY_GROUPS=diarization
WORKER_TORCH_FLAVOR=gpu
WORKER_PRELOAD_ASR_MODELS=small,base

ASR_MODEL_SIZE=large-v3
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
ASR_CPU_THREADS=12
ASR_BEAM_SIZE=5
ASR_VAD_FILTER=true
ASR_SEGMENT_DURATION_SEC=900
ASR_PARALLEL_WORKERS=4
ASR_MAX_MERGED_SEGMENT_DURATION_SEC=22

DIARIZATION_ENABLED=true
DIARIZATION_MODEL_NAME=pyannote/speaker-diarization-3.1
DIARIZATION_DEVICE=cuda
# Hugging Face token with access to the gated pyannote model. Without it diarization is
# skipped and every transcript segment is labelled UNKNOWN.
DIARIZATION_HF_TOKEN=
DIARIZATION_MIN_OVERLAP_SEC=0.15


# =========================
# WORKER RUNTIME (queue reliability)
# =========================
# Optional stable name for this worker. Defaults to worker-<hostname>-<random>.
WORKER_ID=

# A job is retried at most this many times before it lands in <queue>:dead.
WORKER_MAX_ATTEMPTS=3

# How long a claimed job may go without a lease renewal before another worker may reclaim
# it. The heartbeat renews well inside this window, so it only elapses if the worker died.
# Must comfortably exceed the longest single pipeline stage.
WORKER_VISIBILITY_TIMEOUT_SEC=900

# Heartbeat key clipflow:workers:<worker_id> is refreshed on this interval and expires
# after the TTL, so a dead worker disappears on its own.
WORKER_HEARTBEAT_INTERVAL_SEC=15
WORKER_HEARTBEAT_TTL_SEC=60

# Bounded exponential backoff between retries: base * 2^(attempt-1), capped at max.
WORKER_RETRY_BACKOFF_BASE_SEC=30
WORKER_RETRY_BACKOFF_MAX_SEC=600

# How long a claim blocks before the worker loops (and sweeps for stale jobs).
WORKER_CLAIM_BLOCK_SEC=5

# Delete /work/<job_id> after a successful job. On failure the directory is preserved only
# when this is true, so a failed run can be inspected.
KEEP_WORKDIR_ON_FAILURE=false


# =========================
# SUBPROCESS TIMEOUTS
# =========================
# Every external tool is bounded. Defaults are conservative for long videos; a timeout
# kills the process and the job follows the normal retry path.
DOWNLOAD_TIMEOUT_SEC=3600
FFMPEG_TIMEOUT_SEC=3600
FFPROBE_TIMEOUT_SEC=120

# Max characters of stderr retained when an external command fails.
SUBPROCESS_STDERR_CAPTURE_CHARS=4000


# =========================
# PIPELINE TUNING
# =========================
WORKER_LOG_LEVEL=INFO
CONTROL_PLANE_LOG_LEVEL=INFO

RENDER_MIN_CLIP_DURATION_SEC=25
RENDER_BOUNDARY_SNAP_TOLERANCE_SEC=8
MIN_CUT_DURATION_SEC=25
SHORT_SERIE_MAX_GAP_SEC=22

QA_ENABLED=true
AUTO_REVIEW_ENABLED=true
AUTO_REVIEW_READY_SCORE_THRESHOLD=85
AUTO_REVIEW_BLOCKED_SCORE_THRESHOLD=45
AUTO_REVIEW_MAX_REVIEW_CLIPS=1

CLIPFLOW_API_ENABLED=true
CLIPFLOW_API_TIMEOUT_SEC=20
