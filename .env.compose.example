# =========================================================================
# ClipFlow — Docker Compose environment template
#
# Copy to `.env` and fill in every value marked REQUIRED before starting.
# This file must never contain a real secret.
#
# Generate strong values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# =========================================================================


# =========================
# APPLICATION
# =========================
# "production" (default) or one of: development, dev, test, testing, local.
# Anything unrecognised is treated as production. A development environment is the ONLY
# way to enable FIXED_TEST_OTP below.
ENVIRONMENT=production

# Image tags. Compose builds these from the repo; override only to use a registry.
CLIPFLOW_API_IMAGE=clipflow-api:local
VOXMIND_CONTROL_PLANE_IMAGE=clipflow-control-plane:local
VOXMIND_WORKER_IMAGE=clipflow-worker:local
VOXMIND_WORKER_BASE_IMAGE=clipflow-worker-base:local

# Service ports (host side)
CLIPFLOW_API_PORT=8010
CONTROL_PLANE_PORT=8000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8010
COOKIE_SECURE=false
COOKIE_SAMESITE=lax


# =========================
# DATABASE
# =========================
POSTGRES_DB=clipflow
POSTGRES_USER=clipflow
# REQUIRED
POSTGRES_PASSWORD=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# Postgres is only used by clipflow-api, so it is bound to loopback by default.
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_EXPOSE_PORT=5432


# =========================
# REDIS
# =========================
VOXMIND_REDIS_QUEUE=voxmind_jobs
# Redis is only used inside the Compose network, so it is bound to loopback by default.
REDIS_BIND_HOST=127.0.0.1
REDIS_EXPOSE_PORT=6379


# =========================
# MINIO
# =========================
# REQUIRED
MINIO_ROOT_USER=
# REQUIRED
MINIO_ROOT_PASSWORD=

MINIO_BUCKET=voxmind
CLIPFLOW_MINIO_BUCKET=clipflow

# The API port must stay reachable from the browser: presigned asset URLs point at it.
MINIO_API_PORT=9000
# The console is admin-only, so it is bound to loopback by default.
MINIO_CONSOLE_BIND_HOST=127.0.0.1
MINIO_CONSOLE_PORT=9001

# PUBLIC endpoint — the host:port a browser can actually reach. Presigned URLs are signed
# against this value (SigV4 covers the Host header, so the host cannot be rewritten after
# signing). Set it to the address users type, e.g. `clipflow.example.com:9000`.
# The INTERNAL endpoint (minio:9000) is set by docker-compose.yml and is not configured here.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SECURE=false

SIGNED_ASSET_URL_EXPIRY_SEC=3600


# =========================
# INTERNAL AUTH
# =========================
# REQUIRED. Shared secret for every /internal/* endpoint (worker and control-plane → API).
# Minimum 16 characters. The API refuses to start without it, and every internal call is
# rejected when it is missing — there is no fail-open path.
INTERNAL_API_TOKEN=


# =========================
# JWT
# =========================
# REQUIRED. Minimum 16 characters. There is no fallback secret; the API refuses to start
# without it.
JWT_SECRET=


# =========================
# AUTHENTICATION / OTP
# =========================
# LIMITATION: no SMS provider is integrated yet. In production the login code is generated
# randomly and written to the clipflow-api container log only:
#   docker compose logs clipflow-api | grep otp_issued_without_sms_provider
#
# FIXED_TEST_OTP pins the login code for local development. It is honoured ONLY when
# ENVIRONMENT is a development environment; setting it with ENVIRONMENT=production makes
# the API refuse to start. Leave it empty for production.
FIXED_TEST_OTP=

DEFAULT_ADMIN_PHONE_NUMBER=+5500000000000
DEFAULT_ADMIN_FULL_NAME=ClipFlow Admin
DEFAULT_ADMIN_CREDITS=999999
LAB_UNLIMITED_CREDIT_PHONE_NUMBERS=


# =========================
# TELEGRAM
# =========================
# REQUIRED
TELEGRAM_BOT_TOKEN=
# REQUIRED — the operational chat the bot reports into.
TELEGRAM_CHAT_ID=

# Authorization allowlists (comma-separated numeric Telegram ids).
# The bot is DENY-BY-DEFAULT: an id in neither list cannot run /new, /finalize, or send
# JSON. When both are empty, TELEGRAM_CHAT_ID is used as the single authorized chat.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=

TELEGRAM_DISABLE_NOTIFICATIONS=false
TELEGRAM_TIMEOUT_SEC=30
TELEGRAM_UPLOAD_TIMEOUT_SEC=300


# =========================
# AI
# =========================
# AI_MODE: "automatic" (worker calls the AI provider router) or "manual" (legacy Telegram
# prompt/response.json flow). A per-job `build_ia` flag overrides this.
AI_MODE=automatic

# REQUIRED when AI_MODE=automatic and no local provider is enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional local LLM node (e.g. an Ollama-compatible API). Entirely optional: with
# LOCAL_LLM_ENABLED=false nothing is contacted, and with it enabled but unreachable the
# router falls back to OpenAI. The platform never requires the local node to be online.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=qwen3:8b


# =========================
# GPU / ASR
# =========================
CUDA_VISIBLE_DEVICES=0

# Worker image build args
WORKER_POETRY_GROUPS=diarization
WORKER_TORCH_FLAVOR=gpu
WORKER_PRELOAD_ASR_MODELS=small,base

ASR_MODEL_SIZE=large-v3
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
ASR_CPU_THREADS=12
ASR_BEAM_SIZE=5
ASR_VAD_FILTER=true

# Long videos are transcribed in windows. Windows OVERLAP so a sentence spoken across a
# boundary is not cut in half by the extraction; the duplicated speech is then reconciled.
# (ASR_SEGMENT_DURATION_SEC is still accepted as the old name for the window duration.)
ASR_WINDOW_DURATION_SEC=900
ASR_WINDOW_OVERLAP_SEC=5

# Windows are transcribed sequentially. This value is passed to the model as `num_workers`
# (intra-window batching); it does NOT process windows in parallel. See README.
ASR_PARALLEL_WORKERS=4
ASR_MAX_MERGED_SEGMENT_DURATION_SEC=22

# Word-level timings improve seam matching at the cost of an extra alignment pass.
ASR_WORD_TIMESTAMPS=false

# Seam duplicate-detection policy. Every threshold lives here; see
# worker/app/media/seam_reconciler.py for what each one governs.
ASR_SEAM_MIN_TEMPORAL_IOU=0.30
ASR_SEAM_MIN_TEXT_SIMILARITY=0.60
ASR_SEAM_STRONG_TEXT_SIMILARITY=0.85

# The transcript keeps what was actually said. Enable only if a consumer needs filler words
# and immediate repetitions pre-stripped; the result is stored as an extra field, never in
# place of the real text.
ASR_STRIP_FILLERS=false

DIARIZATION_ENABLED=true
DIARIZATION_MODEL_NAME=pyannote/speaker-diarization-3.1
DIARIZATION_DEVICE=cuda
# Hugging Face token with access to the gated pyannote model. Without it diarization is
# skipped and every transcript segment is labelled UNKNOWN.
DIARIZATION_HF_TOKEN=
DIARIZATION_MIN_OVERLAP_SEC=0.15


# =========================
# WORKER RUNTIME (queue reliability)
# =========================
# Optional stable name for this worker. Defaults to worker-<hostname>-<random>.
WORKER_ID=

# A job is retried at most this many times before it lands in <queue>:dead.
WORKER_MAX_ATTEMPTS=3

# How long a claimed job may go without a lease renewal before another worker may reclaim
# it. The heartbeat renews well inside this window, so it only elapses if the worker died.
# Must comfortably exceed the longest single pipeline stage.
WORKER_VISIBILITY_TIMEOUT_SEC=900

# Heartbeat key clipflow:workers:<worker_id> is refreshed on this interval and expires
# after the TTL, so a dead worker disappears on its own.
WORKER_HEARTBEAT_INTERVAL_SEC=15
WORKER_HEARTBEAT_TTL_SEC=60

# Bounded exponential backoff between retries: base * 2^(attempt-1), capped at max.
WORKER_RETRY_BACKOFF_BASE_SEC=30
WORKER_RETRY_BACKOFF_MAX_SEC=600

# How long a claim blocks before the worker loops (and sweeps for stale jobs).
WORKER_CLAIM_BLOCK_SEC=5

# Delete /work/<job_id> after a successful job. On failure the directory is preserved only
# when this is true, so a failed run can be inspected.
KEEP_WORKDIR_ON_FAILURE=false


# =========================
# SUBPROCESS TIMEOUTS
# =========================
# Every external tool is bounded. Defaults are conservative for long videos; a timeout
# kills the process and the job follows the normal retry path.
DOWNLOAD_TIMEOUT_SEC=3600
FFMPEG_TIMEOUT_SEC=3600
FFPROBE_TIMEOUT_SEC=120

# Max characters of stderr retained when an external command fails.
SUBPROCESS_STDERR_CAPTURE_CHARS=4000


# =========================
# PIPELINE TUNING
# =========================
WORKER_LOG_LEVEL=INFO
CONTROL_PLANE_LOG_LEVEL=INFO

RENDER_MIN_CLIP_DURATION_SEC=25
RENDER_BOUNDARY_SNAP_TOLERANCE_SEC=8
MIN_CUT_DURATION_SEC=25
SHORT_SERIE_MAX_GAP_SEC=22

# ======================================
# Discovery (PR-DISCOVERY-01)
# --------------------------------------------------------------------------------
# All optional. With no key the YouTube provider reports itself unavailable and the API
# still boots: an optional integration must not be able to stop the stack, and a missing
# credential is never replaced with fabricated results. The RSS provider needs no key —
# its configuration is the feed_url on each DiscoverySource.
# ======================================
YOUTUBE_API_KEY=
# Per query. YouTube's own ceiling is 50. A search costs 100 quota units of a 10,000/day
# allowance, so this is the main lever on how much of it one run spends.
DISCOVERY_MAX_RESULTS=25
# How far back a run looks when the topic does not say.
DISCOVERY_FRESHNESS_DAYS=7
DISCOVERY_HTTP_TIMEOUT_SEC=15

# ======================================
# Publishing (PR-PUBLISH-01)
# --------------------------------------
# The global publish kill switch. Default OFF, and for a harder reason than the automation
# one: publishing is the only boundary in this system that cannot be undone from the inside.
# A duplicated render costs GPU time; a duplicated upload is public.
#
# Nothing calls the publisher automatically. This switch guards the manual admin command, so
# a deployment that never opted in cannot publish even by operator error.
# ======================================
PUBLISHING_ENABLED=false

# Encrypts YouTube refresh tokens at rest. Without it a target cannot be connected at all -
# the connect flow refuses to start rather than storing a credential in the clear.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes every stored token unreadable; they must be reconnected.
PUBLISH_SECRET_KEY=

# OAuth client from Google Cloud Console (YouTube Data API v3 enabled), type "Web application".
# Empty means the provider is not configured: publishing is refused, never faked.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Must match a redirect URI registered on that client, byte for byte. Read from here and
# never rebuilt from request headers - deriving it from Host would let a spoofed header
# redirect an authorization code somewhere else.
#   local:      http://localhost:8010/auth/youtube/callback
#   production: https://<your-domain>/auth/youtube/callback
YOUTUBE_OAUTH_REDIRECT_URI=

# How long one upload may take before the client gives up. A timeout here is the ambiguous
# case: the bytes may have landed, so it resolves to UNKNOWN and never to a blind retry.
YOUTUBE_UPLOAD_TIMEOUT_SEC=900
# Resumable chunk size in MiB. Floored to a multiple of 256 KiB, which the API requires.
YOUTUBE_UPLOAD_CHUNK_MIB=8

# ======================================
# Publication runtime (PR-PUBLISH-QUEUE-01)
# --------------------------------------
# Publishing runs in its own container (clipflow-publisher) rather than inside the HTTP
# request: an upload can take longer than any proxy timeout between an operator and the API,
# and the publication carried on regardless - so the request was reporting a failure that had
# not happened.
#
# The queue is separate from the media queue on purpose. A render retry costs GPU time; a
# publication retry can cost a duplicate public video, so they need different timeouts,
# budgets, and rules about when a redelivery may repeat the work.
# ======================================
PUBLISH_QUEUE_NAME=clipflow_publish_jobs
# Pin a readable name for one publisher. Empty means it derives one from the container id.
PUBLISHER_WORKER_ID=

# How long a claimed command stays invisible without a heartbeat. Generous: an upload
# legitimately takes minutes, and recovering a command that is still uploading is the
# expensive mistake.
PUBLISH_VISIBILITY_TIMEOUT_SEC=900
# Well under the visibility timeout, so a live worker renews several times over.
PUBLISH_HEARTBEAT_INTERVAL_SEC=20
PUBLISH_HEARTBEAT_TTL_SEC=60
PUBLISH_CLAIM_BLOCK_SEC=5

# The TOTAL execution budget for one publication. The provider client does not retry
# internally, so this is not multiplied by anything.
PUBLISH_MAX_ATTEMPTS=3
PUBLISH_RETRY_BACKOFF_BASE_SEC=30
PUBLISH_RETRY_BACKOFF_MAX_SEC=900
# Quota is not a transient error: YouTube's daily quota resets on a schedule we are not told,
# so retrying it every 30 seconds spends the rest of the day proving that.
PUBLISH_QUOTA_BACKOFF_SEC=3600

# How often the publisher looks for attempts that were committed but never enqueued, and for
# commands whose worker died.
PUBLISH_SWEEP_INTERVAL_SEC=60
PUBLISH_SHUTDOWN_GRACE_SEC=30

# ======================================
# Autonomous publication (PR-PUBLISH-02)
# --------------------------------------
# The switch that lets the system publish without a human deciding each video. Separate from
# PUBLISHING_ENABLED on purpose: a deployment that has deliberately turned on manual
# publishing must not start publishing by itself because a new image shipped.
#
# Recommended rollout:
#   Stage A  PUBLISHING_ENABLED=true,  AUTOPUBLISH_ENABLED=false   manual only
#   Stage B  AUTOPUBLISH_ENABLED=true, AUTOPUBLISH_PUBLIC_ENABLED=false   automatic, private
#   Stage C  AUTOPUBLISH_PUBLIC_ENABLED=true   after validating stage B for real
#
# Every switch below is a ceiling, and every one of them must pass. Three more gates live in
# the database and are not here: the topic's automation config, the target's
# autopublish_enabled, and the explicit publish_target_id routing a topic to a channel.
# ======================================
AUTOPUBLISH_ENABLED=false

# A third switch, because "publish automatically" and "publish automatically to the whole
# internet" are different risks. Automatic + private can be validated for days before
# anything becomes visible.
AUTOPUBLISH_PUBLIC_ENABLED=false
AUTOPUBLISH_DEFAULT_PRIVACY=private

# Deliberately tiny. One per tick means a mistake surfaces after one video rather than after
# a channel full of them; the loop runs often enough that a real backlog still drains.
# Both are clamped server-side, so a mistyped 100000 becomes a small number and not a
# runaway.
AUTOPUBLISH_MAX_PER_TICK=1
AUTOPUBLISH_MAX_PER_DAY=3

# Operational backpressure. If publications are already piling up unexecuted, or no publisher
# is alive, creating more only makes the pile bigger.
AUTOPUBLISH_MAX_QUEUE_BACKLOG=20
# Not zero-tolerance: one ancient dead-lettered command must not stop publishing forever.
AUTOPUBLISH_MAX_DEAD_LETTER=10

# ======================================
# Operational signals and hygiene (PR-AUTONOMY-HARDEN-01)
# --------------------------------------
# GET /admin/operations/health evaluates these against current state. It is the PRODUCT's
# health, not the process's: /health and /ready stay what an orchestrator watches, so a
# YouTube token expiring can never make Docker restart a working API.
# ======================================

# Enough dead-lettered publication commands to be a pattern rather than one bad video.
OPERATIONS_DEAD_LETTER_THRESHOLD=3
# A stall is work that has WAITED this long with a live publisher and nothing settling -
# not merely a deep queue, which is what a healthy system draining a backlog looks like.
OPERATIONS_STALL_WINDOW_SEC=1800
# Consecutive automation failures for one topic before it is worth saying so.
OPERATIONS_FAILURE_THRESHOLD=3

# How long an automation runner's heartbeat survives without a tick. Comfortably more than
# one poll interval, so a slow tick is not mistaken for a dead loop.
AUTOMATION_HEARTBEAT_TTL_SEC=180

# A publication spool older than this was left by a process that no longer exists: `finally`
# does not run on SIGKILL. Comfortably longer than any single upload, so a file a live
# publisher is still streaming from is never removed.
PUBLISH_TEMP_STALE_SEC=21600

# ======================================
# Autonomous pipeline (PR-SCHEDULER-01)
# --------------------------------------------------------------------------------
# The global kill switch. Default OFF: this is the flag that lets ClipFlow start production
# on its own, and shipping a new image must not begin doing that by itself.
#
# Turning it off stops the WORK, not the scheduler — the loop keeps ticking and the API stays
# healthy, so re-enabling needs no restart. It also gates the deprecated seed-URL scheduler,
# so the two autonomous producers can never compete for worker slots.
#
# Per-topic policy (interval, stage switches, limits, backlog cap) is NOT here: it belongs to
# the editorial intention and lives in ContentTopic.metadata_json["automation"].
# ======================================
# Root log level for the application. Uvicorn configures only its own loggers, so without a
# level here the scheduler's tick reports never reach stderr.
LOG_LEVEL=INFO

AUTONOMOUS_PIPELINE_ENABLED=false
# How often the loop looks for due topics. Not the run interval — that is per topic.
AUTOMATION_POLL_INTERVAL_SEC=60
AUTOMATION_STARTUP_DELAY_SEC=15
# Lets this process skip running the loop without changing whether automation may act at all.
AUTOMATION_RUNNER_ENABLED=true

# ======================================
# Selection (PR-SELECTION-01)
# --------------------------------------------------------------------------------
# Optional. With no key the semantic evaluator reports itself unavailable and selection
# continues on deterministic signals alone, with a raised score threshold — less evidence
# means more caution, never a fabricated relevance number.
#
# Policy (weights, caps, thresholds, cooldown) is NOT configured here: it belongs to the
# editorial intention and lives in ContentTopic.metadata_json["selection"].
# ======================================
SELECTION_OPENAI_API_KEY=
SELECTION_MODEL=gpt-4o-mini
SELECTION_TIMEOUT_SEC=20

# Layer A - source/editorial QA over the chosen cut ranges.
QA_ENABLED=true
AUTO_REVIEW_ENABLED=true
AUTO_REVIEW_READY_SCORE_THRESHOLD=85
AUTO_REVIEW_BLOCKED_SCORE_THRESHOLD=45
AUTO_REVIEW_MAX_REVIEW_CLIPS=1

# Layer B - the technical gate over the assembled MP4 that would actually be published.
# Disabling it does NOT make jobs auto-ready: with no technical verdict the gate is
# "unmeasurable" and auto-review falls back to requiring a human.
FINAL_QA_ENABLED=true
# Encoder and timebase drift, not editorial slack. Measured on a real render: +0.189s on a
# modelled 43.478s timeline. The check also allows 2% of the expected duration.
FINAL_QA_DURATION_TOLERANCE_SEC=1.5
# Longest silent stretch before a render needs a human ear. Silence over half the running
# time blocks outright.
FINAL_QA_MAX_SILENCE_SEC=8
# Fraction of the running time that may be (almost) black before blocking.
FINAL_QA_BLACK_RATIO=0.60
FINAL_QA_MAX_FREEZE_SEC=4
# One bounded full decode of the final file - the decode integrity check.
FINAL_QA_DECODE_TIMEOUT_SEC=900

CLIPFLOW_API_ENABLED=true
CLIPFLOW_API_TIMEOUT_SEC=20

# ======================================
# Performance metrics ingestion (PR-METRICS-01)
#
# Measurement, not optimization. Nothing here can change what gets discovered, selected,
# produced or published - these settings only decide how often the system looks at what
# already happened. There is no feedback loop yet, by design.
# ======================================

# Off by default like every other autonomous behaviour: collection spends YouTube quota on a
# schedule, and starting to spend it should be a decision someone made.
METRICS_COLLECTION_ENABLED=false

# How long a publication stays interesting. Views keep accruing for ever, but the shape worth
# watching is early; past this the series is history rather than signal, and polling it would
# spend the quota fresh videos need.
METRICS_TRACKING_DAYS=30

# The cadence table, by the age of the video. Newer videos move faster, so they are watched
# more closely. A fixed rule rather than an adaptive scheduler: quota is the binding
# constraint, and an operator should be able to predict the bill.
METRICS_INTERVAL_FRESH_HOURS=1
METRICS_INTERVAL_RECENT_HOURS=6
METRICS_INTERVAL_MATURE_HOURS=24

# How often the automation loop even considers collecting. Much longer than the production
# poll interval, because the finest cadence above is hourly.
METRICS_POLL_INTERVAL_SEC=900

# A ceiling on one run, so a backlog drains over several ticks instead of emptying the day's
# quota in one.
METRICS_MAX_VIDEOS_PER_RUN=200

# How stale collection gets before the operational signal mentions it. That signal is LOW
# severity by construction: analytics running late is an inconvenience, never an incident,
# and it must never be what makes the product report degraded.
METRICS_STALE_HOURS=48
